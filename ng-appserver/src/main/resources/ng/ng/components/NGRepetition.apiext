<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="NGRepetition" content="expected" unknownAttributes="forbidden">

		<doc><![CDATA[Renders its content once per item of `list` (with `item` set to the current object) or, alternatively, `count` times. Exactly one of `list` and `count` must be bound. `index` receives the zero-based iteration number either way.]]></doc>

		<binding name="list">
			<pull><type>java.util.List</type><type>java.util.SequencedCollection</type></pull>
			<doc><![CDATA[The objects to iterate over: a `java.util.List`, a Java array, or any `SequencedCollection` (copied to a list). Pulled once per phase; `null` is treated as empty. Mutually exclusive with `count`.]]></doc>
		</binding>

		<binding name="item">
			<push><type>java.lang.Object</type></push>
			<doc><![CDATA[**Pushed** the current object before each iteration (and reset to `null` when the repetition finishes). Required when `list` is bound.]]></doc>
		</binding>

		<binding name="index">
			<push><type>java.lang.Integer</type></push>
			<doc><![CDATA[**Pushed** the zero-based number of the current iteration.]]></doc>
		</binding>

		<binding name="count">
			<pull><type>java.lang.Integer</type></pull>
			<doc><![CDATA[Iterate this many times instead of over a list. Pulled; an integer (a numeric constant in the template is accepted). Mutually exclusive with `list`.]]></doc>
		</binding>

		<choose min="1" max="1">
			<binding name="list"/>
			<binding name="count"/>
		</choose>
		<requires binding="item" when="list"/>

	</wo>
</wodefinitions>
