<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="NGPasswordField" content="forbidden" unknownAttributes="passthrough">

		<doc><![CDATA[An `<input type="password">`. The submitted text is **pushed** into `value` (`null` when empty); the current value is never rendered back to the browser. Other bindings are rendered as attributes. Tag name: `password`.]]></doc>

		<binding name="value" required="true">
			<push><type>java.lang.String</type></push>
			<doc><![CDATA[Receives the submitted password as a `String` (`null` for an empty field). **Push only** — never rendered. Required.]]></doc>
		</binding>

		<binding name="name">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The HTML form-field name. Pulled; auto-assigned from the element ID when unbound — bind it only when other code needs to know the field name.]]></doc>
		</binding>

		<binding name="disabled" defaults="YES/NO">
			<pull><type interpretation="truthy">java.lang.Object</type></pull>
			<doc><![CDATA[When truthy the field renders with the `disabled` attribute and its submitted value is ignored (nothing is pushed).]]></doc>
		</binding>

	</wo>
</wodefinitions>
