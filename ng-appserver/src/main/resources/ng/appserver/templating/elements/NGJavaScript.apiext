<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="NGJavaScript" content="forbidden" unknownAttributes="forbidden">

		<doc><![CDATA[Renders a `<script src="…">` tag for a webserver resource. Tag name: `script`.]]></doc>

		<binding name="filename" required="true">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The name of the JavaScript resource in `namespace`. Pulled; required. Renders `ERROR_NOT_FOUND_<filename>` as the URL when the resource doesn't exist.]]></doc>
		</binding>

		<binding name="namespace">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The resource namespace to look `filename` up in. Pulled; when unbound, the namespace of the component rendering the element is used.]]></doc>
		</binding>

		<binding name="framework">
			<pull><type>java.lang.String</type></pull>
			<deprecated><![CDATA[Use `namespace` instead — `framework` is the legacy name, still honoured (with a logged warning).]]></deprecated>
			<doc><![CDATA[Legacy name for `namespace`.]]></doc>
		</binding>

	</wo>
</wodefinitions>
